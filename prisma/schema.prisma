generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  business
  user
}

enum TaskStatus {
  open
  closed
}

enum AcceptanceStatus {
  accepted
  submitted
  approved
  rejected
}

model Account {
  id        String      @id @default(cuid())
  name      String
  kind      AccountKind
  avatarUrl String?
  createdAt DateTime    @default(now())

  tasksAsBusiness   Task[]            @relation("BusinessTasks")
  acceptances       TaskAcceptance[]  @relation("UserAcceptances")
  paymentsReceived  Payment[]         @relation("UserPayments")
  paymentsSent      Payment[]         @relation("BusinessPayments")
}

model Task {
  id                  String     @id @default(cuid())
  businessId          String
  title               String
  description         String
  submissionCriteria  String
  rewardCents         BigInt
  category            String?
  deadline            DateTime?
  status              TaskStatus @default(open)
  createdAt           DateTime   @default(now())

  business    Account          @relation("BusinessTasks", fields: [businessId], references: [id], onDelete: Cascade)
  acceptances TaskAcceptance[]

  @@index([status])
  @@index([businessId])
  @@index([category])
  @@index([rewardCents])
  @@index([createdAt])
}

model TaskAcceptance {
  id         String           @id @default(cuid())
  taskId     String
  userId     String
  status     AcceptanceStatus @default(accepted)
  acceptedAt DateTime         @default(now())

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       Account     @relation("UserAcceptances", fields: [userId], references: [id], onDelete: Cascade)
  submission Submission?

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

model Submission {
  id             String    @id @default(cuid())
  acceptanceId   String    @unique
  submissionUrl  String
  notes          String?
  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?
  reviewerNotes  String?

  acceptance TaskAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  payment    Payment?
}

model Payment {
  id           String   @id @default(cuid())
  submissionId String   @unique
  userId       String
  businessId   String
  amountCents  BigInt
  paidAt       DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       Account    @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  business   Account    @relation("BusinessPayments", fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
}

model IdempotencyKey {
  key          String
  actorId      String
  scope        String
  requestHash  String
  responseJson Json
  statusCode   Int
  createdAt    DateTime @default(now())

  @@id([key, actorId, scope])
  @@index([createdAt])
}
